# ==============================================================================
# NyayaFlow - Environment Template (.env.example)
# ==============================================================================

# LLM Provider Configuration
# Set to 'groq' for ultra-fast production inference (default)
# Set to 'ollama' for offline local development
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# 1. Groq Cloud Configuration (Primary Production LLM)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. Ollama Configuration (Local Development Provider)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ------------------------------------------------------------------------------
# 3. Dense Embedding Model & Vector Search (pgvector)
# ------------------------------------------------------------------------------
# Default lightweight 384-dim engine for Render free tier: deterministic-feature-hashing-384
# Optional PyTorch transformer (requires >800MB RAM): sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=deterministic-feature-hashing-384
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 4. Database (PostgreSQL / Supabase pgvector)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyayaflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ------------------------------------------------------------------------------
# 5. Core Services
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
STORAGE_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

